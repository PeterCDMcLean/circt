# Bazel module definition for the CIRCT Bazel overlay.
#
# CIRCT itself only ships CMake. This module makes the covered subset of CIRCT
# buildable with Bazel *on top of* an existing Bazel build of LLVM/MLIR, which
# is exposed to us as the repository `@llvm-project`.
#
# There are two ways to consume this module. See docs/bazel.md for the full
# discussion; in short:
#
#   A. In-tree / sibling repository (recommended, and the only model that works
#      when `@llvm-project` is generated by a repository rule or module
#      extension in the *consumer's* module):
#
#          # consumer's MODULE.bazel
#          local_repository = use_repo_rule(
#              "@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
#          local_repository(name = "circt", path = "third_party/circt")
#
#      With this model the repository below is *not* used as a module at all;
#      `@llvm-project` in the CIRCT BUILD files resolves through the consumer's
#      own repository mapping.
#
#   B. External Bazel module:
#
#          # consumer's MODULE.bazel
#          bazel_dep(name = "circt", version = "0.1.0")
#          local_path_override(module_name = "circt", path = "third_party/circt")
#          bazel_dep(name = "llvm-project-overlay", version = "0.0.0")
#          local_path_override(
#              module_name = "llvm-project-overlay",
#              path = "third_party/llvm-project/utils/bazel")
#
#      Here the module graph is what supplies `@llvm-project`, so it must be a
#      real module (or be produced by `--override_repository`). LLVM repositories
#      generated by a module extension of a *different* module are not visible
#      to us; that is a bzlmod repo-mapping restriction, not something this
#      overlay can work around.
module(
    name = "circt",
    version = "0.1.0",
    compatibility_level = 1,
)

# `@rules_cc` is required by Bazel >= 8, where `cc_library` may only be loaded
# from `@rules_cc//cc:cc_library.bzl`.
bazel_dep(name = "rules_cc", version = "0.2.25")

# Used indirectly by `@llvm-project//mlir:tblgen.bzl`; declaring it here keeps
# the dependency explicit and lets consumers override it.
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# LLVM/MLIR, in its Bazel-overlay form. Upstream LLVM names this module
# `llvm-project-overlay` and asks consumers to map it to the repository name
# `llvm-project`; the CIRCT BUILD files only ever use `@llvm-project//...`.
#
# The version below is a placeholder: consumers are expected to pin it with
# `local_path_override`, `git_override`, `archive_override`, or
# `single_version_override`. Without such an override module resolution fails
# with "module not found in registry", which is intentional - the overlay
# cannot pick an LLVM revision for the consumer.
bazel_dep(
    name = "llvm-project-overlay",
    version = "0.0.0",
    repo_name = "llvm-project",
)
