# `CIRCTVerif` (lib/Dialect/Verif).
#
# CMake reference: `lib/Dialect/Verif/CMakeLists.txt`.
#
# Not built: `lib/Dialect/Verif/Transforms` (and the SMT/Z3 lowering of the
# `verif` dialect, which is excluded from this overlay).

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "circt_verif",
    srcs = [
        "VerifDialect.cpp",
        "VerifOpInterfaces.cpp",
        "VerifOps.cpp",
    ],
    deps = [
        "//include/circt/Dialect/HW:headers",
        "//include/circt/Dialect/LTL:headers",
        "//include/circt/Dialect/Seq:headers",
        "//include/circt/Dialect/Verif:headers",
        "//include/circt/Support:headers",
        "//lib/Dialect/HW:circt_hw",
        "//lib/Dialect/LTL:circt_ltl",
        "//lib/Dialect/Seq:circt_seq",
        "//lib/Support:circt_support",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:Transforms",
    ],
)
