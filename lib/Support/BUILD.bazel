# `CIRCTSupport` (lib/Support).
#
# CMake reference: `lib/Support/CMakeLists.txt`.
#
# `Version.cpp` is generated by CMake from `Version.cpp.in` and the git hash.
# Bazel builds must be hermetic, so we substitute a fixed string instead: the
# version string is cosmetic (it only shows up in generated Radix-style
# comments). Consumers that care can override the `:version_cpp` genrule.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "version_cpp",
    srcs = ["Version.cpp.in"],
    outs = ["Version.cpp"],
    cmd = "sed -e 's/@CIRCT_VERSION@/bazel-overlay/' $(location Version.cpp.in) > $@",
)

# Mirrors CIRCTSupport's source list minus the optional CaDiCaL dependency:
# `SATSolver.cpp` compiles to its "no solver available" fallback unless
# `CIRCT_CADICAL_ENABLED` is defined.
cc_library(
    name = "circt_support",
    srcs = [
        "APInt.cpp",
        "BackedgeBuilder.cpp",
        "CustomDirectiveImpl.cpp",
        "Debug.cpp",
        "FVInt.cpp",
        "FieldInfo.cpp",
        "FieldRef.cpp",
        "InstanceGraph.cpp",
        "JSON.cpp",
        "LoweringOptions.cpp",
        "Naming.cpp",
        "ParsingUtils.cpp",
        "Passes.cpp",
        "Path.cpp",
        "PrettyPrinter.cpp",
        "PrettyPrinterHelpers.cpp",
        "ProceduralRegionTrait.cpp",
        "SATSolver.cpp",
        "SymCache.cpp",
        "TruthTable.cpp",
        "ValueMapper.cpp",
        ":version_cpp",
    ],
    deps = [
        "//include/circt/Support:headers",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TransformUtils",
        "@llvm-project//mlir:Transforms",
    ],
)
