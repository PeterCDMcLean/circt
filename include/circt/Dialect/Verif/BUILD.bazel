# TableGen and header rules for `include/circt/Dialect/Verif`.
#
# CMake reference: `include/circt/Dialect/Verif/CMakeLists.txt` plus
# `add_circt_dialect(Verif verif)` and `add_circt_interface(VerifOpInterfaces)`.

load("@llvm-project//mlir:tblgen.bzl", "td_library")
load("//bazel:circt.bzl", "circt_gentbl", "circt_headers")

package(default_visibility = ["//visibility:public"])

td_library(
    name = "td_files",
    srcs = glob(["*.td"]),
    includes = ["/include"],
)

# TableGen inputs needed by the `.td` files in this package: its own files
# plus the CIRCT packages whose `.td` files they include textually. These
# deps live here, not on `:td_files`, because some dialects include each
# other (e.g. `seq` and `sim`) and a cycle in the target graph would be an
# error even though the textual `.td` includes are legal.
TD_DEPS = [
    ":td_files",
    "//include/circt/Dialect/HW:td_files",
    "//include/circt/Dialect/LTL:td_files",
    "//include/circt/Dialect/Seq:td_files",
]

# `add_circt_dialect(Verif verif)`.
circt_gentbl(
    name = "MLIRVerifIncGen",
    tbl_outs = {
        "Verif.h.inc": ["-gen-op-decls"],
        "Verif.cpp.inc": ["-gen-op-defs"],
        "VerifTypes.h.inc": [
            "-gen-typedef-decls",
            "-typedefs-dialect=verif",
        ],
        "VerifTypes.cpp.inc": [
            "-gen-typedef-defs",
            "-typedefs-dialect=verif",
        ],
        "VerifDialect.h.inc": [
            "-gen-dialect-decls",
            "-dialect=verif",
        ],
        "VerifDialect.cpp.inc": [
            "-gen-dialect-defs",
            "-dialect=verif",
        ],
    },
    td_file = "Verif.td",
    deps = TD_DEPS,
)

circt_gentbl(
    name = "CIRCTVerifEnumsIncGen",
    tbl_outs = {
        "VerifEnums.h.inc": ["-gen-enum-decls"],
        "VerifEnums.cpp.inc": ["-gen-enum-defs"],
    },
    td_file = "Verif.td",
    deps = TD_DEPS,
)

circt_gentbl(
    name = "MLIRVerifOpInterfacesIncGen",
    tbl_outs = {
        "VerifOpInterfaces.h.inc": ["-gen-op-interface-decls"],
        "VerifOpInterfaces.cpp.inc": ["-gen-op-interface-defs"],
    },
    td_file = "VerifOpInterfaces.td",
    deps = TD_DEPS,
)

circt_gentbl(
    name = "CIRCTVerifTransformsIncGen",
    tbl_outs = {
        "Passes.h.inc": ["-gen-pass-decls"],
    },
    td_file = "Passes.td",
    deps = TD_DEPS,
)

circt_headers(
    name = "headers",
    srcs = glob(["*.h"]),
    deps = [
        ":CIRCTVerifEnumsIncGen",
        ":CIRCTVerifTransformsIncGen",
        ":MLIRVerifIncGen",
        ":MLIRVerifOpInterfacesIncGen",
        "//include/circt/Dialect/HW:headers",
        "//include/circt/Dialect/LTL:headers",
        "//include/circt/Dialect/Seq:headers",
        "//include/circt/Support:headers",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:Transforms",
    ],
)
