# Prototype fork: vendored CIRCT dialect sources (hw + comb) built against the
# same @llvm-project revision as Mojo. This is the "vendor the needed dialects"
# step from mojo-hdl-analysis/03-circt-integration.md §9.1.
#
# Only the top-level dialect libraries are built; CIRCT's transforms, reductions,
# ExportVerilog and other dialects are not vendored yet.

load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

TD_INCLUDES = ["include"]

td_library(
    name = "CIRCTAllTdFiles",
    srcs = glob(["include/circt/**/*.td"]),
    includes = TD_INCLUDES,
    deps = [
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
        "@llvm-project//mlir:FunctionInterfacesTdFiles",
        "@llvm-project//mlir:ControlFlowInterfacesTdFiles",
        "@llvm-project//mlir:CallInterfacesTdFiles",
        "@llvm-project//mlir:CastInterfacesTdFiles",
        "@llvm-project//mlir:InferTypeOpInterfaceTdFiles",
        "@llvm-project//mlir:InferIntRangeInterfaceTdFiles",
        "@llvm-project//mlir:MemorySlotInterfacesTdFiles",
        "@llvm-project//mlir:DataLayoutInterfacesTdFiles",
        "@llvm-project//mlir:FuncTdFiles",
        "@llvm-project//mlir:ArithOpsTdFiles",
    ],
)

#===----------------------------------------------------------------------===#
# Support
#===----------------------------------------------------------------------===#

gentbl_cc_library(
    name = "SupportInstanceGraphIncGen",
    tbl_outs = {
        "include/circt/Support/InstanceGraphInterface.h.inc": ["-gen-op-interface-decls"],
        "include/circt/Support/InstanceGraphInterface.cpp.inc": ["-gen-op-interface-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Support/InstanceGraphInterface.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

cc_library(
    name = "circt_support",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/circt/Support/*.h"]),
    includes = TD_INCLUDES,
    deps = [
        ":SupportInstanceGraphIncGen",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TransformUtils",
        "@llvm-project//mlir:Transforms",
    ],
)

#===----------------------------------------------------------------------===#
# Emit dialect (only the op interfaces HW depends on)
#===----------------------------------------------------------------------===#

gentbl_cc_library(
    name = "EmitOpInterfacesIncGen",
    tbl_outs = {
        "include/circt/Dialect/Emit/EmitOpInterfaces.h.inc": ["-gen-op-interface-decls"],
        "include/circt/Dialect/Emit/EmitOpInterfaces.cpp.inc": ["-gen-op-interface-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/Emit/EmitOpInterfaces.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

#===----------------------------------------------------------------------===#
# HW dialect
#===----------------------------------------------------------------------===#

gentbl_cc_library(
    name = "HWDialectIncGen",
    tbl_outs = {
        "include/circt/Dialect/HW/HWDialect.h.inc": ["-gen-dialect-decls"],
        "include/circt/Dialect/HW/HWDialect.cpp.inc": ["-gen-dialect-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HWDialect.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

gentbl_cc_library(
    name = "HWIncGen",
    tbl_outs = {
        "include/circt/Dialect/HW/HW.h.inc": ["-gen-op-decls"],
        "include/circt/Dialect/HW/HW.cpp.inc": ["-gen-op-defs"],
        "include/circt/Dialect/HW/HWTypes.h.inc": ["-gen-typedef-decls"],
        "include/circt/Dialect/HW/HWTypes.cpp.inc": ["-gen-typedef-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HW.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

gentbl_cc_library(
    name = "HWAttributesIncGen",
    tbl_outs = {
        "include/circt/Dialect/HW/HWAttributes.h.inc": ["-gen-attrdef-decls"],
        "include/circt/Dialect/HW/HWAttributes.cpp.inc": ["-gen-attrdef-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HW.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

gentbl_cc_library(
    name = "HWEnumsIncGen",
    tbl_outs = {
        "include/circt/Dialect/HW/HWEnums.h.inc": ["-gen-enum-decls"],
        "include/circt/Dialect/HW/HWEnums.cpp.inc": ["-gen-enum-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HWEnums.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

gentbl_cc_library(
    name = "HWOpInterfacesIncGen",
    tbl_outs = {
        "include/circt/Dialect/HW/HWOpInterfaces.h.inc": ["-gen-op-interface-decls"],
        "include/circt/Dialect/HW/HWOpInterfaces.cpp.inc": ["-gen-op-interface-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HWOpInterfaces.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

gentbl_cc_library(
    name = "HWTypeInterfacesIncGen",
    tbl_outs = {
        "include/circt/Dialect/HW/HWTypeInterfaces.h.inc": ["-gen-type-interface-decls"],
        "include/circt/Dialect/HW/HWTypeInterfaces.cpp.inc": ["-gen-type-interface-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HWTypeInterfaces.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

gentbl_cc_library(
    name = "HWCanonicalizationIncGen",
    strip_include_prefix = "include/circt/Dialect/HW",
    tbl_outs = {
        "include/circt/Dialect/HW/HWCanonicalization.cpp.inc": ["-gen-rewriters"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/HW/HWCanonicalization.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

cc_library(
    name = "circt_hw",
    srcs = glob(
        ["lib/Dialect/HW/*.cpp"],
        exclude = ["lib/Dialect/HW/HWReductions.cpp"],
    ),
    hdrs = glob([
        "include/circt/Dialect/HW/*.h",
        "include/circt/Dialect/Emit/*.h",
    ]),
    includes = TD_INCLUDES,
    deps = [
        ":EmitOpInterfacesIncGen",
        ":HWAttributesIncGen",
        ":HWCanonicalizationIncGen",
        ":HWDialectIncGen",
        ":HWEnumsIncGen",
        ":HWIncGen",
        ":HWOpInterfacesIncGen",
        ":HWTypeInterfacesIncGen",
        ":circt_support",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:CallOpInterfaces",
        "@llvm-project//mlir:ControlFlowInterfaces",
        "@llvm-project//mlir:DataLayoutInterfaces",
        "@llvm-project//mlir:FunctionInterfaces",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:InferIntRangeCommon",
        "@llvm-project//mlir:InferIntRangeInterface",
        "@llvm-project//mlir:InferTypeOpInterface",
        "@llvm-project//mlir:MemorySlotInterfaces",
        "@llvm-project//mlir:SideEffectInterfaces",
        "@llvm-project//mlir:Support",
    ],
)

#===----------------------------------------------------------------------===#
# Comb dialect
#===----------------------------------------------------------------------===#

gentbl_cc_library(
    name = "CombDialectIncGen",
    tbl_outs = {
        "include/circt/Dialect/Comb/CombDialect.h.inc": ["-gen-dialect-decls"],
        "include/circt/Dialect/Comb/CombDialect.cpp.inc": ["-gen-dialect-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/Comb/CombDialect.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
