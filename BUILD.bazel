gentbl_cc_library(
    name = "CombEnumsIncGen",
    tbl_outs = {
        "include/circt/Dialect/Comb/CombEnums.h.inc": ["-gen-enum-decls"],
        "include/circt/Dialect/Comb/CombEnums.cpp.inc": ["-gen-enum-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/Comb/Comb.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
)

cc_library(
    name = "circt_comb",
    srcs = glob(["lib/Dialect/Comb/*.cpp"]),
    hdrs = glob(["include/circt/Dialect/Comb/*.h"]),
    includes = TD_INCLUDES,
    deps = [
        ":CombDialectIncGen",
        ":CombEnumsIncGen",
        ":CombIncGen",
        ":circt_hw",
        ":circt_support",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:InferIntRangeInterface",
        "@llvm-project//mlir:InferTypeOpInterface",
        "@llvm-project//mlir:Support",
    ],
)
