gentbl_cc_library(
    name = "CombIncGen",
    tbl_outs = {
        "include/circt/Dialect/Comb/Comb.h.inc": ["-gen-op-decls"],
        "include/circt/Dialect/Comb/Comb.cpp.inc": ["-gen-op-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/circt/Dialect/Comb/Comb.td",
    deps = [":CIRCTAllTdFiles"],
    includes = TD_INCLUDES,
